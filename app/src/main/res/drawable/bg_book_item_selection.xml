<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_primary_light">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/surface_elevated" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="@color/color_primary" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/surface_elevated" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.5dp" android:color="@color/color_primary" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_card" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/surface_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
