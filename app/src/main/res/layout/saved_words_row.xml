<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Word Title + Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/saved_words_textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Resilience" />

                <TextView
                    android:id="@+id/saved_words_phonetic_textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="/rɪˈzɪl.jəns/" />
            </LinearLayout>

            <!-- Edit Reader Details Button -->
            <ImageButton
                android:id="@+id/btn_edit_reader_details"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Reader Details"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/color_accent" />

            <!-- TTS Audio Button -->
            <ImageButton
                android:id="@+id/btn_audio_saved_word"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Audio Pronounce"
                android:padding="6dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/color_primary" />

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/btn_share_saved_word"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share"
                android:padding="6dp"
                android:src="@drawable/ic_share"
                app:tint="@color/color_primary" />

            <!-- PDF Export Button -->
            <ImageButton
                android:id="@+id/btn_pdf_saved_word"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="PDF"
                android:padding="6dp"
                android:src="@drawable/ic_pdf"
                app:tint="@color/color_danger" />

            <!-- Copy Button -->
            <ImageButton
                android:id="@+id/btn_copy_saved_word"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy"
                android:padding="6dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/surface_stroke" />

        <!-- Meanings Container -->
        <LinearLayout
            android:id="@+id/ll_meanings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Reader Metadata Container -->
        <LinearLayout
            android:id="@+id/ll_reader_metadata_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Divider before Reader Details -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/surface_stroke" />

            <!-- Where Found (Chapter & Page) -->
            <LinearLayout
                android:id="@+id/ll_reader_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="FOUND WHILE READING"
                    android:textColor="@color/color_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reader_found_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="serif"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    tools:text="Chapter 7 · Page 143" />
            </LinearLayout>

            <!-- Highlight -->
            <LinearLayout
                android:id="@+id/ll_reader_highlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:background="@color/surface_elevated"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:visibility="gone">

                <!-- Left Accent Border -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:background="@color/color_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="MY HIGHLIGHT"
                        android:textColor="@color/color_accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_reader_highlight_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:textColor="@color/text_color"
                        android:textSize="13sp"
                        tools:text="&quot;Her happiness was ephemeral.&quot;" />
                </LinearLayout>
            </LinearLayout>

            <!-- Note -->
            <LinearLayout
                android:id="@+id/ll_reader_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="MY NOTE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reader_note_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_color"
                    android:textSize="13sp"
                    tools:text="A word I want to remember because it appeared several times." />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
