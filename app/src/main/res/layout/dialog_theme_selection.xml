<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:maxWidth="400dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textColor="@color/text_color"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose your preferred reading theme."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/theme_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- Light Mode Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_color"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp">

                    <RadioButton
                        android:id="@+id/radio_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="☀  Light Mode\n    Bright and clean paper aesthetic"
                        android:textColor="@color/text_color"
                        android:textSize="14sp"
                        android:buttonTint="@color/color_primary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Dark Mode Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_color"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp">

                    <RadioButton
                        android:id="@+id/radio_dark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="🌙  Dark Mode\n    Comfortable for reading at night"
                        android:textColor="@color/text_color"
                        android:textSize="14sp"
                        android:buttonTint="@color/color_primary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- System Theme Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_color"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/surface_stroke"
                    app:strokeWidth="1dp">

                    <RadioButton
                        android:id="@+id/radio_system"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="📱  System Default\n    Follow device system theme"
                        android:textColor="@color/text_color"
                        android:textSize="14sp"
                        android:buttonTint="@color/color_primary" />
                </com.google.android.material.card.MaterialCardView>

            </RadioGroup>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_theme_dialog"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
