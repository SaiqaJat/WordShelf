<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_history"
    style="@style/Widget.MaterialComponents.Chip.Action"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:textColor="@color/text_color"
    android:textSize="13sp"
    app:chipBackgroundColor="@color/surface_elevated"
    app:chipCornerRadius="16dp"
    app:chipIcon="@drawable/ic_search"
    app:chipIconSize="16dp"
    app:chipIconTint="@color/text_secondary"
    app:chipStrokeColor="@color/surface_stroke"
    app:chipStrokeWidth="1dp"
    app:closeIconVisible="true"
    app:closeIconTint="@color/text_hint" />
