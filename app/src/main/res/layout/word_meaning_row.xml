<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Part of Speech Chip -->
        <TextView
            android:id="@+id/parts_of_speech_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_bg"
            android:backgroundTint="@color/chip_noun_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/chip_noun_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Noun" />

        <!-- Definitions Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Definitions"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <!-- Definitions Content -->
        <TextView
            android:id="@+id/definitions_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_color"
            android:textSize="15sp"
            tools:text="1. The occurrence and development of events by chance in a happy or beneficial way." />

        <!-- Synonyms Block -->
        <LinearLayout
            android:id="@+id/ll_synonyms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/synonyms_title_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Synonyms"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/synonyms_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                tools:text="chance, fluke, coincidence, luck" />
        </LinearLayout>

        <!-- Antonyms Block -->
        <LinearLayout
            android:id="@+id/ll_antonyms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/antonyms_title_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Antonyms"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/antonyms_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/color_danger"
                android:textSize="14sp"
                tools:text="misfortune, bad luck" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
