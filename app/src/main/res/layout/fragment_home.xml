<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:padding="@dimen/screen_margin"
    tools:context=".HomeFragment">

    <!-- Main Content Scroll Container Centered for Tablets & Desktop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical">

        <!-- Reader Companion Header Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Reading Companion"
                android:textColor="@color/text_color"
                android:textSize="@dimen/header_title_size"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Discover definitions, phonetics, and context while reading."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/sub_title_size" />
        </LinearLayout>

        <!-- Floating Search Bar Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/search_card_radius"
            app:cardElevation="4dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/search"
                    app:tint="@color/color_primary"
                    android:contentDescription="@string/search" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="12dp"
                    android:background="@null"
                    android:hint="Search an unfamiliar word..."
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_color"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="4dp"
                    android:indeterminateTint="@color/color_primary"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/search_icon"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="Search"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/color_primary"
                    app:cornerRadius="24dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Search History Section -->
        <LinearLayout
            android:id="@+id/container_recent_searches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Searches"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear All"
                    android:textColor="@color/color_accent"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_searches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_history_chip" />
        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_empty_dictionary"
                android:contentDescription="Search Icon"
                app:tint="@color/color_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Explore Literature Vocabulary"
                android:textColor="@color/text_color"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Search unfamiliar words as you read novels and books. Save definitions into custom book shelves for future review."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Error State Container (404 / Connection Error) -->
        <LinearLayout
            android:id="@+id/error_state_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/error_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_clear"
                app:tint="@color/color_danger"
                android:contentDescription="Error Icon" />

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Unable to fetch definition"
                android:textColor="@color/text_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Check your internet connection and try searching again."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_search"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="16dp"
                android:text="Retry Search"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- Skeleton Loading State (shown while API fetch is in progress) -->
        <include
            layout="@layout/skeleton_word_result"
            android:id="@+id/skeleton_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Stale Cache Warning Bar (shown when displaying an offline/cached result) -->
        <TextView
            android:id="@+id/stale_warning_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/stale_warning_bg"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:text="⚠ Showing cached result — check your connection"
            android:textColor="@color/stale_warning_text"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Searched Word Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_word_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="3dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/ll_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/word_textView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/word_title_size"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        tools:text="Serendipity" />

                    <TextView
                        android:id="@+id/phonetic_textView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:visibility="gone"
                        tools:text="/ˌsɛr.ənˈdɪp.ə.ti/" />
                </LinearLayout>

                <!-- Audio TTS Button -->
                <ImageButton
                    android:id="@+id/btn_audio_pronounce"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/color_primary_light"
                    android:contentDescription="Pronounce"
                    android:padding="10dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/color_primary" />

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/btn_share_searched_word"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/color_primary_light"
                    android:contentDescription="Share"
                    android:padding="10dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/color_primary" />

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_to_book_btn"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/color_primary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_save"
                    app:iconTint="@color/color_on_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Meanings RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_word_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:listitem="@layout/word_meaning_row" />

    </LinearLayout>

    <!-- Autocomplete Popup Suggestions Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_autocomplete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/surface_stroke"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_autocomplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
